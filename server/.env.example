# Copy to server/.env. Without MONGODB_URI the API runs in demo mode (in-memory seed data).
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio
# Comma-separated list of allowed client origins
CORS_ORIGIN=http://localhost:5173

# Admin (JWT). Use a long random secret, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
ADMIN_PASSWORD=
JWT_SECRET=

# Optional: email each contact message to you via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
